{
  "$schema": "https://opencode.ai/config.json",
  "project": {
    "name": "HomeVpn",
    "language": [
      "python",
      "bash",
      "bat"
    ]
  },
  "lsp": {
    "python": {
      "initialization": {
        "python.analysis": {
          "indexing": true,
          "pythonVersion": "3.12",
          "extraPaths": [
            "./lib/python"
          ]
        }
      }
    },
    "bash": {
      "extensions": [
        ".sh",
        ".bash",
        ".bat",
        ".cmd"
      ]
    }
  }
}